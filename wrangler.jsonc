{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livro-receitas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "livro-receitas"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EBOOKS",
      "bucket_name": "receitas-premium-150-ebooks"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "receitas-premium-150-orders",
      "database_id": "e5ba3e0b-eff5-4bfd-8461-fe09c1eceb7a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CHECKOUT_ENABLED": "true",
    "MERCADOPAGO_MODE": "production",
    "LIVE_PAYMENTS_ENABLED": "true"
  },
  "keep_vars": true
}
